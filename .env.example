# Razorpay (test/sandbox keys — never live keys in this project)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this SAME value in the Razorpay dashboard when you configure a real
# webhook (Settings -> Webhooks). Until then it's just used to sign/verify
# locally-simulated test payloads.
RAZORPAY_WEBHOOK_SECRET=

# TEMPORARY: placeholder auth.users row, used as task_state.user_id until
# real Supabase Auth is wired into the app. Remove once that exists.
DEV_USER_ID=

# Groq (dispatcher + evaluator agents)
GROQ_API_KEY=

# Supabase (Postgres + Auth + Realtime)
SUPABASE_URL=
# "Publishable key" in the dashboard (safe for the browser, RLS-restricted)
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" in the dashboard (server-only — bypasses RLS, never expose to frontend)
SUPABASE_SECRET_KEY=
# Direct Postgres connection string (for migrations / raw SQL)
SUPABASE_DB_URL=

# Redis (idempotency layer, via docker-compose)
REDIS_URL=redis://localhost:6379/0
