# Razorpay test/sandbox credentials — never live keys in this project
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Policy gate thresholds — all per-agent, reset daily (see src/resetDailyLimits.ts)
# NOTE: amounts are in PAISE (Razorpay's smallest currency unit), so divide
# by 100 for rupees. Agents converting a user's "₹500" to 50000 paise is
# correct and expected — set these accordingly.
DAILY_CAP=2500000       # ₹25,000 per day, across ALL payment tools combined
SINGLE_TXN_CAP=1000000  # ₹10,000 per single transaction
MAX_PAYEES=3            # distinct payees per day

# Path to the SQLite file (idempotency_store + audit_log)
DB_PATH=./data/guardrail.db
